# Synthetic demo configuration only. Never place production credentials here.
APP_ENV=demo
DEMO_MODE=true
COMPOSE_PROJECT_NAME=ai-review-console-upgrade
POSTGRES_PASSWORD=synthetic-demo-only
DATABASE_URL=sqlite:///./review_console_upgrade.sqlite3
LANGFLOW_URL=http://langflow:7860
LANGFLOW_API_KEY=replace-with-runtime-secret
REVIEW_SERVICE_TOKEN=synthetic-demo-service-token
DOCUMENTS_ROOT=/tmp/ai-review-console-documents
REPORTS_ROOT=/tmp/ai-review-console-reports
LANGFLOW_FLOW_MANIFEST=/tmp/arc-upgrade-langflow-flows.json
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_ENABLE_SIGNUP=false
LANGFLOW_WEBHOOK_AUTH_ENABLE=true
LANGFLOW_ALLOW_CUSTOM_COMPONENTS=false
LANGFLOW_CUSTOM_COMPONENT_ADMIN_ONLY=true
LANGFLOW_SUPERUSER=review-admin
LANGFLOW_SUPERUSER_PASSWORD=synthetic-demo-change-me
LANGFLOW_SECRET_KEY=synthetic-demo-secret-change-me
VITE_API_BASE_URL=/api
