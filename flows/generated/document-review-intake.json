          "type": "ApprovalTaskGateway",
          "display_name": "Approval Task Gateway",
          "description": "Create an asynchronous human approval task without blocking the Langflow run.",
          "node": {
            "template": {
              "_type": "Component",
              "assessment": {
                "tool_mode": false,
                "trace_as_metadata": true,
                "list": false,
                "list_add_label": "Add More",
                "trace_as_input": true,
                "override_skip": false,
                "required": true,
                "placeholder": "",
                "show": true,
                "name": "assessment",
                "value": "",
                "display_name": "Risk Assessment",
                "advanced": false,
                "api_editable": false,
                "input_types": [
                  "Data",
                  "JSON"
                ],
                "dynamic": false,
                "info": "",
                "title_case": false,
                "track_in_telemetry": false,
                "type": "other",
                "_input_type": "JSONInput"
              },
              "code": {
                "type": "code",
                "required": true,
                "placeholder": "",
                "list": false,
                "show": true,
                "multiline": true,
                "value": "import hashlib\nimport os\n\nimport httpx\nfrom lfx.custom.custom_component.component import Component\nfrom lfx.io import DataInput, Output, SecretStrInput, StrInput\nfrom lfx.schema import Data\n\n\nclass ApprovalTaskGateway(Component):\n    display_name = \"Approval Task Gateway\"\n    description = \"Create an asynchronous human approval task without blocking the Langflow run.\"\n    icon = \"user-check\"\n    name = \"ApprovalTaskGateway\"\n\n    inputs = [\n        DataInput(name=\"assessment\", display_name=\"Risk Assessment\", required=True),\n        StrInput(\n            name=\"review_api_url\",\n            display_name=\"Review API URL\",\n            value=\"http://api:8000\",\n            advanced=True,\n        ),\n        SecretStrInput(\n            name=\"service_token\",\n            display_name=\"Service Token\",\n            value=\"\",\n            required=False,\n            advanced=True,\n        ),\n    ]\n    outputs = [Output(name=\"task\", display_name=\"Approval Task\", method=\"create_task\")]\n\n    def create_task(self) -> Data:\n        payload = dict(self.assessment.data)\n        assessment = payload.get(\"risk_assessment\", {})\n        case_id = str(payload.get(\"case_id\") or \"\")\n        if not case_id:\n            digest = hashlib.sha256(str(payload.get(\"sha256\", \"synthetic\")).encode()).hexdigest()[\n                :10\n            ]\n            case_id = f\"LF-{digest}\"\n        task = {\n            \"case_id\": case_id,\n            \"status\": \"pending_approval\",\n            \"risk_score\": assessment.get(\"score\", 0),\n            \"risk_level\": assessment.get(\"level\", \"low\"),\n            \"idempotency_key\": f\"{case_id}:{assessment.get('ruleset_version', 'unknown')}\",\n        }\n        endpoint = f\"{self.review_api_url.rstrip('/')}/api/integrations/langflow/tasks\"\n        headers = {\"X-Service-Token\": self.service_token or os.getenv(\"REVIEW_SERVICE_TOKEN\", \"\")}\n        try:\n            response = httpx.post(endpoint, json=task, headers=headers, timeout=10)\n            if response.status_code not in {200, 201, 409}:\n                response.raise_for_status()\n            task[\"gateway_result\"] = response.json()\n        except httpx.HTTPError as exc:\n            task[\"gateway_result\"] = {\"mode\": \"degraded\", \"error\": str(exc)}\n        self.status = f\"Approval task {task['status']} for {case_id}\"\n        return Data(data=task)\n",
